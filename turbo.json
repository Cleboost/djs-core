{
	"$schema": "https://v2-10-9.turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"types": {
			"dependsOn": ["^build", "^types"],
			"outputs": ["dist/**/*.d.ts"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
