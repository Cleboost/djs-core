{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"packages/runtime": {},
		"packages/dev": {
			"entry": "index.ts"
		},
		"plugins/plugin-demo": {
			"entry": "index.ts"
		},
		"plugins/plugin-prisma-sqlite": {
			"entry": "index.ts"
		},
		"plugins/plugin-sql": {
			"entry": "index.ts"
		},
		"plugins/plugin-drizzle": {
			"entry": "index.ts",
			"ignoreDependencies": ["drizzle-kit"]
		},
		"app": {
			"entry": [
				"djs.config.ts",
				"prisma.config.ts",
				"drizzle.config.ts",
				"src/**/*.ts"
			],
			"ignoreDependencies": ["dotenv", "prisma", "drizzle-kit"]
		}
	},
	"ignoreBinaries": ["tail"],
	"ignore": ["packages/utils/**", "website/**"]
}
