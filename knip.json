{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"packages/runtime": {},
		"packages/db": {
			"entry": ["index.ts", "runtime.ts", "test/**/*.test.ts"],
			"ignore": ["test/fixtures/**"]
		},
		"packages/dev": {
			"entry": "index.ts"
		},
		"plugins/plugin-demo": {
			"entry": "index.ts"
		},
		"plugins/plugin-prisma-sqlite": {
			"entry": "index.ts"
		},
		"plugins/plugin-sql": {
			"entry": "index.ts"
		},
		"plugins/plugin-drizzle": {
			"entry": "index.ts",
			"ignoreDependencies": ["drizzle-kit"]
		},
		"app": {
			"entry": [
				"djs.config.ts",
				"prisma.config.ts",
				"drizzle.config.ts",
				"src/**/*.ts"
			],
			"ignore": ["db/schema.ts"],
			"ignoreDependencies": ["dotenv", "prisma", "drizzle-kit"],
			"ignoreUnresolved": ["#db"]
		}
	},
	"ignoreBinaries": ["tail"],
	"ignore": ["website/**"]
}
