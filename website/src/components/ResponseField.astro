---
interface Props {
  name: string;
  type?: string;
  required?: boolean;
}
const { name, type, required } = Astro.props;
---
<div class="response-field">
  <div class="response-field-header">
    <span class="response-field-name">{name}</span>
    {type && <span class="response-field-type">{type}</span>}
    {required && <span class="response-field-required">required</span>}
  </div>
  <div class="response-field-desc"><slot /></div>
</div>
