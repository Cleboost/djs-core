---
import { getCollection, render } from "astro:content";
import DocsLayout from "@layouts/DocsLayout.astro";
import Card from "@components/Card.astro";
import CardGroup from "@components/CardGroup.astro";
import Note from "@components/Note.astro";
import Tip from "@components/Tip.astro";
import Warning from "@components/Warning.astro";
import Info from "@components/Info.astro";
import Steps from "@components/Steps.astro";
import Step from "@components/Step.astro";
import Accordion from "@components/Accordion.astro";
import AccordionGroup from "@components/AccordionGroup.astro";
import ResponseField from "@components/ResponseField.astro";
import Columns from "@components/Columns.astro";
import Column from "@components/Column.astro";
import Experimental from "@components/Experimental.astro";
import { entrySlug } from "@lib/slug";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => {
    const slug = entrySlug(entry.id);
    return {
      params: { slug: slug || undefined },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entrySlug(entry.id);
---

<DocsLayout title={entry.data.title} description={entry.data.description} slug={slug}>
  <Content
    components={{
      Card,
      CardGroup,
      Note,
      Tip,
      Warning,
      Info,
      Steps,
      Step,
      Accordion,
      AccordionGroup,
      ResponseField,
      Columns,
      Column,
      Experimental,
    }}
  />
</DocsLayout>
