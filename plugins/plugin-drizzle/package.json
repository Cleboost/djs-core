{
	"name": "@djs-core/plugin-drizzle",
	"version": "1.0.3",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "bun build index.ts --outdir dist --target bun --external @djs-core/runtime --external discord.js --external drizzle-orm --external drizzle-kit --external bun:sqlite --external postgres --external mysql2 --external @libsql/client --minify",
		"types": "tsc --project tsconfig.json",
		"prepack": "bun run build && bun run types"
	},
	"dependencies": {
		"drizzle-orm": "0.45.2"
	},
	"peerDependencies": {
		"@djs-core/runtime": ">=1.13.1",
		"discord.js": "catalog:",
		"drizzle-orm": "0.45.2"
	},
	"devDependencies": {
		"@djs-core/runtime": "workspace:*",
		"@libsql/client": "0.17.4",
		"@types/bun": "1.3.14",
		"drizzle-kit": "0.31.10",
		"mysql2": "3.24.2",
		"postgres": "3.4.9"
	},
	"peerDependenciesMeta": {
		"postgres": {
			"optional": true
		},
		"mysql2": {
			"optional": true
		},
		"@libsql/client": {
			"optional": true
		},
		"drizzle-kit": {
			"optional": true
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Cleboost/djs-core"
	}
}
