{
	"name": "@djs-core/plugin-prisma-sqlite",
	"version": "1.0.3",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "bun build index.ts --outdir dist --target bun --external @djs-core/runtime --external discord.js --external @prisma/client --external prisma --minify",
		"types": "tsc --project tsconfig.json",
		"prepack": "bun run build && bun run types"
	},
	"dependencies": {
		"@prisma/client": "7.9.1",
		"prisma": "7.9.1"
	},
	"peerDependencies": {
		"@djs-core/runtime": ">=1.13.1",
		"discord.js": "14.25.1"
	},
	"devDependencies": {
		"@djs-core/runtime": "workspace:*",
		"@types/bun": "1.3.14",
		"prisma-adapter-bun-sqlite": "0.8.0"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Cleboost/djs-core"
	}
}
