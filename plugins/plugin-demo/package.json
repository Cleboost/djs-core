{
	"name": "@djs-core/plugin-demo",
	"version": "0.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"private": true,
	"scripts": {
		"build": "bun build index.ts --outdir dist --target bun --external @djs-core/runtime --external discord.js --minify",
		"types": "tsc --project tsconfig.json",
		"prepack": "bun run build && bun run types"
	},
	"peerDependencies": {
		"@djs-core/runtime": ">=1.13.1",
		"discord.js": "catalog:"
	},
	"devDependencies": {
		"@djs-core/runtime": "workspace:*",
		"@types/bun": "1.3.14"
	},
	"files": [
		"dist"
	]
}
