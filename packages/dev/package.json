{
	"name": "@djs-core/dev",
	"version": "5.3.0",
	"description": "Development CLI tools for djs-core Discord bot framework",
	"type": "module",
	"types": "./dist/index.d.ts",
	"bin": {
		"djs-core": "dist/index.js"
	},
	"scripts": {
		"build": "bun build index.ts --outdir dist --target bun --external @djs-core/runtime --external discord.js --minify",
		"types": "dts-bundle-generator -o dist/index.d.ts index.ts --no-check --project tsconfig.json",
		"dev": "bun build index.ts --outdir dist --target bun --watch",
		"test": "bun test",
		"sync-docs": "bun run scripts/sync-docs.ts",
		"prepack": "turbo build types && bun run scripts/sync-docs.ts"
	},
	"dependencies": {
		"@clack/prompts": "1.5.1",
		"@djs-core/runtime": "workspace:*",
		"cac": "7.0.0",
		"chokidar": "5.0.0",
		"picocolors": "1.1.1",
		"ts-morph": "28.0.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"dts-bundle-generator": "9.5.1"
	},
	"peerDependencies": {
		"discord.js": "14.25.1"
	},
	"files": [
		"dist",
		"docs"
	],
	"author": "Cleboost",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cleboost/djs-core.git",
		"directory": "packages/dev"
	},
	"publishConfig": {
		"access": "public"
	}
}
