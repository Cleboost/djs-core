{
	"name": "@djs-core/testing",
	"version": "1.0.0",
	"description": "Testing utilities and mocks for djs-core Discord bots",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun build index.ts --outdir dist --target bun --external @djs-core/runtime --external discord.js --minify",
		"types": "tsc --project tsconfig.json",
		"test": "bun test",
		"prepack": "bun turbo build types"
	},
	"peerDependencies": {
		"@djs-core/runtime": "^1.13.0",
		"discord.js": "catalog:"
	},
	"devDependencies": {
		"@djs-core/runtime": "workspace:*",
		"@types/bun": "1.3.14",
		"discord.js": "catalog:"
	},
	"files": [
		"dist"
	],
	"author": "Cleboost",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cleboost/djs-core.git",
		"directory": "packages/testing"
	},
	"publishConfig": {
		"access": "public"
	}
}
