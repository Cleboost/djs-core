{
	"name": "@djs-core/runtime",
	"version": "1.13.1",
	"description": "Runtime library for djs-core Discord bot framework",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"dev": "bun build index.ts --outdir dist --target bun --external discord.js --watch",
		"build": "bun build index.ts --outdir dist --target bun --external discord.js --minify",
		"types": "tsc --project tsconfig.json",
		"test": "bun test",
		"prepack": "bun turbo build types"
	},
	"dependencies": {
		"cron": "4.4.0",
		"picocolors": "1.1.1",
		"semver": "7.7.3"
	},
	"peerDependencies": {
		"discord.js": "14.26.5"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/semver": "7.7.1"
	},
	"files": [
		"dist",
		"PLUGIN_API_CHANGELOG.md"
	],
	"author": "Cleboost",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cleboost/djs-core.git",
		"directory": "packages/runtime"
	},
	"publishConfig": {
		"access": "public"
	}
}
