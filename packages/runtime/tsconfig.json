{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"stripInternal": true,
		"outDir": "./dist",
		"noEmit": false,
		"module": "ESNext",
		"moduleResolution": "bundler"
	},
	"include": ["index.ts", "**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
